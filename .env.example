# The generation model is an enforced invariant. Changing this value makes startup fail.
RAG_GENERATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct
RAG_GENERATION_REVISION=7ae557604adf67be50417f59c2c2f167def9a775

RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a

RAG_ENVIRONMENT=development
RAG_DEVICE=auto
# Set true after the pinned model snapshots have been prefetched.
RAG_OFFLINE_MODE=false
RAG_USE_RERANKER=true
RAG_MINIMUM_SIMILARITY=0.65
RAG_TOP_K=5
RAG_CANDIDATE_K=24
RAG_REQUEST_CONCURRENCY=1
RAG_CHILD_CHUNK_SIZE=320
RAG_CHILD_CHUNK_OVERLAP=50
RAG_MAX_GENERATION_SOURCES=1
RAG_MAX_ANSWER_SENTENCES=2
RAG_MAX_ANSWER_CHARS=600

# Required before binding the API to a public/non-loopback interface.
RAG_API_KEY=replace-with-a-long-random-value
